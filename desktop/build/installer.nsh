; Halaman Welcome ala wizard klasik (pakai gambar sidebar Nusa)
!macro customWelcomePage
  !define MUI_WELCOMEPAGE_TITLE "Welcome to Nusa Setup"
  !define MUI_WELCOMEPAGE_TEXT "This will install Nusa ${VERSION} on your computer.$\r$\n$\r$\nNusa is a Dynamic Island for your desktop: music, reminders, prayer times, Quran, weather and focus, right at the top of your screen.$\r$\n$\r$\nIt is recommended that you close other applications before continuing.$\r$\n$\r$\nClick Next to continue."
  !insertmacro MUI_PAGE_WELCOME
!macroend
